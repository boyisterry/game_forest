/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-mcp/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
._*
.AppleDouble
*.pem

# debug
npm-debug.log*
