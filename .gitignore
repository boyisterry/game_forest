# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/dist.locked-prev*/
/build/
/.wrangler/
/outputs/
/work/
/.worktrees/
